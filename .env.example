# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_secret_password
MYSQL_DATABASE=blog_db
MYSQL_USER=blog_user
MYSQL_PASSWORD=blog_secret

# ASP.NET Core Backend
ASPNETCORE_ENVIRONMENT=Production
DB_CONNECTION_STRING=Server=db;Port=3306;Database=blog_db;User=blog_user;Password=blog_secret;
StaticPostsPath=/var/www/static_blogs

# Nginx Gateway
NGINX_PORT=80
